{
  "name": "phase3_branch_model",
  "input_shape": [3, 16, 16],
  "layers": [
    {"type": "conv2d", "out_channels": 8, "kernel_size": 3, "stride": 1, "padding": 1},
    {"type": "relu"},
    {
      "type": "branch",
      "merge": "add",
      "branches": [
        [
          {"type": "conv2d", "out_channels": 8, "kernel_size": 3, "stride": 1, "padding": 1},
          {"type": "batch_norm2d"}
        ],
        [{"type": "identity"}]
      ]
    },
    {"type": "relu"},
    {
      "type": "branch",
      "merge": "concat",
      "branches": [
        [{"type": "conv2d", "out_channels": 4, "kernel_size": 3, "stride": 1, "padding": 1}],
        [{"type": "max_pool2d", "kernel_size": 1, "stride": 1, "padding": 0}]
      ]
    },
    {"type": "flatten"},
    {"type": "linear", "out_features": 4}
  ]
}
